{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "notesheet-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=web",
        "--",
        "--port",
        "5191",
        "--strictPort"
      ],
      "port": 5191
    },
    {
      "name": "notesheet-web-red",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:red",
        "--workspace=web",
        "--",
        "--port",
        "5192",
        "--strictPort"
      ],
      "port": 5192,
      "url": "https://localhost:5192"
    }
  ]
}
